# @revelio/ingest - the one-shot job that runs migrations, seeds Postgres from
# card-data, indexes Meilisearch and uploads card images to S3/RustFS.
#
# Nothing auto-loads this file: main.ts reads process.env, so pass it in
# explicitly. It is a reference for a real (staging/production) ingest run:
#   docker run --env-file ingest/.env ghcr.io/p4per/revelio-ingest:<tag>
#   docker compose run --rm --env-from-file ingest/.env ingest
# The local compose `ingest` service already hardcodes every value below with
# container hostnames, so plain `docker compose run --rm ingest` needs no file.

# ---- Postgres ------------------------------------------------------------
# The only required variable: without it the job exits 1 immediately.
DATABASE_URL=postgres://revelio:revelio@localhost:5432/revelio

# ---- Dataset mounts ------------------------------------------------------
# Built card data, i18n label files and image assets, produced by card-data/.
# The container image defaults to these three paths; set them for a host run.
DATA_DIR=/data
I18N_DIR=/i18n
ASSETS_DIR=/assets

# ---- Meilisearch ---------------------------------------------------------
# Optional as a pair: leave MEILI_HOST unset to seed Postgres only and skip
# indexing. The ingest CREATES indexes and writes documents, so this is the
# one place the MASTER key is needed - web uses a search-only key and a
# scoped write key, the bot a search-only key.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# ---- S3 / RustFS image hosting -------------------------------------------
# S3_ENDPOINT is the switch: unset it and the image upload step is skipped
# entirely. The rest fall back to the defaults shown here.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-central-1
# false for a real AWS S3 endpoint; true for RustFS and other path-style hosts.
S3_FORCE_PATH_STYLE=true
