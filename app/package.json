{
  "name": "revelio-app",
  "private": true,
  "type": "module",
  "workspaces": ["core", "db", "ingest", "search", "web", "bot", "sheet"],
  "engines": { "node": ">=22.22" },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint && npm run lint -w web",
    "db:generate": "npm run generate -w @revelio/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "vite": "^8.3.4",
    "@types/node": "^22.20.5",
    "zod": "^4.6.7",
    "@testcontainers/postgresql": "^12.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
