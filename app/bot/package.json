{
  "name": "@revelio/bot",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "node --env-file-if-exists=.env.local --import tsx src/main.ts",
    "register": "node --env-file-if-exists=.env.local --import tsx src/discord/register-cli.ts",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@revelio/core": "*",
    "@revelio/db": "*",
    "@revelio/search": "*",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "intl-messageformat": "^11.2.15",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
