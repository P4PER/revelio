# @revelio/bot - copy to .env.local and fill in.
#
# .env.local is read two ways, and it is the only file you need to edit:
#   - `npm run dev -w @revelio/bot` loads it directly (host run).
#   - `docker compose --profile bot up bot` loads it too, but the compose
#     service overrides DATABASE_URL and MEILI_HOST with container hostnames,
#     so the localhost values below stay correct for host runs.

# ---- Discord application -------------------------------------------------
# Bot tab -> Token -> Reset Token. Password-equivalent: never commit it.
DISCORD_TOKEN=
# General Information -> Application ID (not the guild id).
DISCORD_CLIENT_ID=
# Optional. Set it to register slash commands into one guild, which is instant.
# Leave blank to register globally, which Discord takes up to an hour to
# propagate - that is the production setting.
DISCORD_GUILD_ID=

# ---- Backing services (localhost + published compose ports) --------------
DATABASE_URL=postgres://revelio:revelio@localhost:5432/revelio
MEILI_HOST=http://localhost:7700
MEILI_SEARCH_KEY=masterKey

# ---- Absolute URLs the bot renders --------------------------------------
# Discord fetches card thumbnails from the public internet, so in a real
# deployment this must be the public bucket URL. Locally they will not render.
IMAGE_BASE_URL=http://localhost:9000/images
SITE_BASE_URL=http://localhost:3000
