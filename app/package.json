{
  "name": "revelio-app",
  "private": true,
  "type": "module",
  "workspaces": ["core", "db", "ingest", "search", "web", "bot"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint && npm run lint -w web",
    "db:generate": "npm run generate -w @revelio/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9",
    "typescript-eslint": "^8.62.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@testcontainers/postgresql": "^10.13.0",
    "drizzle-kit": "^0.31.10"
  }
}
